[TEMPLATE]
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/jobtracker
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=3000
# Comma-separated extra allowed CORS origins for production (localhost dev origins are always allowed).
# e.g. CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=
# Used ONLY by `npm run seed:admin` to create the first administrator.
# Never expose an admin registration endpoint; additional admins use invite tokens.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Admin
# Cloudflare Turnstile (Phase 10). Server-side secret — never expose it to the
# browser and never commit a real value. For local dev use Cloudflare's official
# test keys (docs/TESTING_GUIDE.md). Verification fails closed if this is unset.
TURNSTILE_SECRET_KEY=
# Optional comma-separated allow-list of hostnames Turnstile challenges must come
# from; empty disables the hostname check. In production set it to your web domain.
TURNSTILE_ALLOWED_HOSTNAMES=

# Google OAuth (Phase 9). Leave empty and Google sign-in is reported as
# "not configured". These are secrets — never commit real values.
# GOOGLE_CALLBACK_URL must EXACTLY match the authorized redirect URI in Google
# Cloud Console and route through the Next.js proxy (web origin), e.g.
#   https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# AI (MVP2 Phase 0). Server-side only - never expose to the browser.
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.8-27b:free
AI_MONTHLY_CALL_CAP=50
# Per-request timeout for a provider call. Raise for long CV parsing on the
# free tier, which can be slow (min 5000, default 30000).
AI_TIMEOUT_MS=30000

# CV upload (MVP3 Phase 1). Max accepted CV file size in MB.
CV_MAX_SIZE_MB=5

# LaTeX PDF generation (MVP3 Phase 4). The API shells out to the Docker Engine
# over DOCKER_SOCKET (default /var/run/docker.sock) — mount that socket only for
# a trusted deployment. If the daemon is unreachable, builds fail with a generic
# message instead of taking the API down.
DOCKER_SOCKET=/var/run/docker.sock
LATEX_WORKER_IMAGE=jobtracker/latex-worker:latest
# Wall-clock budget for one container, then it is force-removed (ms).
LATEX_COMPILE_TIMEOUT_MS=15000
# Live split-view preview (MVP3 Phase 6). Same sandbox, lower-res PNG, and a
# shorter budget than the final build because it re-compiles on every pause while
# the user types (ms).
LATEX_PREVIEW_TIMEOUT_MS=8000
# How long an identical preview (same template + same field values) is served
# from memory instead of recompiled (ms). 0 disables caching entirely.
LATEX_PREVIEW_CACHE_TTL_MS=30000
