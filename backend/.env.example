[TEMPLATE]
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/jobtracker
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=3000
# Comma-separated extra allowed CORS origins for production (localhost dev origins are always allowed).
# e.g. CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=
# Used ONLY by `npm run seed:admin` to create the first administrator.
# Never expose an admin registration endpoint; additional admins use invite tokens.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Admin
# Cloudflare Turnstile (Phase 10). Server-side secret — never expose it to the
# browser and never commit a real value. For local dev use Cloudflare's official
# test keys (docs/TESTING_GUIDE.md). Verification fails closed if this is unset.
TURNSTILE_SECRET_KEY=
# Optional comma-separated allow-list of hostnames Turnstile challenges must come
# from; empty disables the hostname check. In production set it to your web domain.
TURNSTILE_ALLOWED_HOSTNAMES=

# Google OAuth (Phase 9). Leave empty and Google sign-in is reported as
# "not configured". These are secrets — never commit real values.
# GOOGLE_CALLBACK_URL must EXACTLY match the authorized redirect URI in Google
# Cloud Console and route through the Next.js proxy (web origin), e.g.
#   https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
