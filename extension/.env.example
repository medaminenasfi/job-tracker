[TEMPLATE]
# Copy to `.env.production` and fill in your live URLs, then run `npm run build`.
# These are PUBLIC build-time values baked into the extension bundle (the extension
# is client-side software) — never put secrets here.

# NestJS API base URL the extension calls directly (must end in /api).
VITE_API_BASE=https://your-backend.onrender.com/api

# Web app origin used by the "Connect extension" / extension-login bridge.
VITE_WEB_ORIGIN=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# ALSO required before a production build (manifest.json is static and cannot
# read env vars): add your real origins so the extension may talk to them and
# run the login-bridge content script.
#
#   "host_permissions": [
#     "https://your-backend.onrender.com/*",   <- API
#     "https://your-app.vercel.app/*",         <- web app (login bridge)
#     "https://*.linkedin.com/*",
#     "https://*.indeed.com/*"
#   ],
#   "content_scripts": [{ "matches": [
#     "https://*.linkedin.com/*",
#     "https://*.indeed.com/*",
#     "https://your-app.vercel.app/*"          <- so the bridge page can post the token
#   ], ... }]
#
# Justify these hosts in the Chrome Web Store listing (single purpose + why each
# host is needed). See docs/DEPLOYMENT_GUIDE.md.
# ---------------------------------------------------------------------------
