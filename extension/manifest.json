{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.0.0",
  "description": "Save and track job applications from any website",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Job Tracker"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "http://localhost:3001/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
