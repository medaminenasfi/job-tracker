[TEMPLATE]
# The web app calls its own origin at /api/* and next.config.mjs rewrites those
# requests to this target, so the httpOnly refresh cookies stay on the web origin.
#   Local dev : http://127.0.0.1:3000  (the Nest backend)
#   Production: your deployed backend URL, e.g. https://jobtracker-api.onrender.com
# On Vercel set this as an environment variable (no leading slash, no trailing /api).
API_PROXY_TARGET=http://127.0.0.1:3000
# Cloudflare Turnstile (Phase 10). Public site key — for local dev use
# Cloudflare's official test keys (see docs/TESTING_GUIDE.md). Never a secret.
# In production use your real Turnstile SITE key (the SECRET stays on the backend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
